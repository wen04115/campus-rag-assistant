# Chat provider. Do not commit a real key.
# DeepSeek is OpenAI-compatible; its key is used only for chat generation.
OPENAI_API_KEY=your-new-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# Embeddings run locally after the first download, so no separate embedding API key is needed.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
